# Copy to `.env.local` for development and `.env.production` for deploy.
# Never commit real secrets.

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
WORKER_NAME=kav-haribis-site

# App URL (no trailing slash)
APP_URL=http://localhost:5173

# Google OAuth
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# D1 database (from: wrangler d1 create ...)
D1_DATABASE_NAME=kav_haribis_db
D1_DATABASE_ID=

# R2 bucket (from: wrangler r2 bucket create ...)
R2_BUCKET_NAME=kav-haribis-files

# Optional payment integration
CARDKNOX_SETTINGS_KEY=
