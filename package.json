{
  "name": "kav-haribis-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "predev": "node scripts/sync-wrangler-config.mjs",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "prebuild": "node scripts/sync-wrangler-config.mjs --production",
    "build": "vinext build",
    "predeploy": "node scripts/sync-wrangler-config.mjs --production",
    "deploy": "node scripts/deploy.mjs",
    "deploy:secrets": "node scripts/push-wrangler-secrets.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/sync-wrangler-config.mjs && node scripts/d1-migrate.mjs --local",
    "db:migrate:remote": "node scripts/sync-wrangler-config.mjs --production && node scripts/d1-migrate.mjs --remote",
    "sync:wrangler": "node scripts/sync-wrangler-config.mjs",
    "sync:wrangler:prod": "node scripts/sync-wrangler-config.mjs --production"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.35.0",
    "next": "16.2.6",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Kav Haribis"
}
